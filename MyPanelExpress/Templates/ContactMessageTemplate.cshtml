@using MyPanelExpress.Models
@model ContactMessageModel

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>Nouveau message de contact</title>
</head>
<body style="margin:0; padding:0; background-color:#f4f4f5; font-family:Arial, Helvetica, sans-serif; color:#18181b;">
    <div style="max-width:600px; margin:0 auto; padding:24px;">
        <div style="background-color:#ffffff; border-radius:8px; padding:24px; border:1px solid #e4e4e7;">

            <h1 style="margin:0 0 4px 0; font-size:20px; color:#18181b;">
                Nouveau message depuis le formulaire de contact
            </h1>
            <p style="margin:0 0 24px 0; font-size:13px; color:#71717a;">
                Reçu le @Model.DateEnvoi.ToLocalTime().ToString("dd/MM/yyyy à HH:mm")
            </p>

            <h2 style="margin:0 0 8px 0; font-size:15px; color:#18181b;">@Model.Sujet</h2>

            <div style="font-size:14px; line-height:1.6; color:#3f3f46; white-space:pre-wrap; padding:16px; background-color:#fafafa; border-radius:6px; border:1px solid #e4e4e7;">@Model.Message</div>

            <h3 style="margin:24px 0 8px 0; font-size:14px; color:#18181b;">Coordonnées</h3>
            <ul style="margin:0; padding:0; list-style:none; font-size:14px; line-height:1.8; color:#3f3f46;">
                <li><strong>Nom :</strong> @Model.Nom</li>
                @if (!string.IsNullOrWhiteSpace(Model.Societe))
                {
                    <li><strong>Société :</strong> @Model.Societe</li>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Telephone))
                {
                    <li><strong>Téléphone :</strong> <a href="tel:@Model.Telephone" style="color:#2563eb;">@Model.Telephone</a></li>
                }
                <li><strong>Email :</strong> <a href="mailto:@Model.Email" style="color:#2563eb;">@Model.Email</a></li>
            </ul>

            <div style="margin-top:24px;">
                <a href="mailto:@Model.Email?subject=RE:%20@Model.Sujet"
                   style="display:inline-block; background-color:#2563eb; color:#ffffff; text-decoration:none; padding:10px 20px; border-radius:6px; font-size:14px;">
                    Répondre à @Model.Nom
                </a>
            </div>

        </div>

        <p style="margin:16px 0 0 0; text-align:center; font-size:12px; color:#a1a1aa;">
            Message envoyé automatiquement depuis le site MyPanelExpress.
        </p>
    </div>
</body>
</html>
