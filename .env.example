# Copier ce fichier en .env (non versionné) et ajuster les valeurs.
# Le même fichier alimente `dotnet run` (via DotEnv.Load) et `docker compose`.

# --- API ---
# API_BACK_URL est l'émetteur ET l'audience du JWT : s'il ne correspond pas,
# tous les tokens émis sont rejetés à la validation.
API_BACK_URL=http://localhost:5196
API_FRONT_URL=http://localhost:4200

# --- Auth ---
# En production : générer une clé longue et aléatoire. Le démarrage échoue si
# elle est laissée à la valeur de développement hors Development.
JWT_KEY=dev-only-key-do-not-use-in-production-averyveryverylongkeyforhmacsha256-0123456789
TOKEN_VALIDITY_MINUTES=30

# --- Administrateur unique (créé au premier démarrage) ---
ADMIN_EMAIL=admin@mypanelexpress.com
ADMIN_PASSWORD=Password123!

# --- Base de données (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mypanelexpress
DB_USER=postgres
DB_PASSWORD=postgres

# --- Stockage objet (MinIO) ---
# En local, MinIO est servi en HTTP clair : MINIO_USE_SSL doit rester false.
MINIO_ENDPOINT=localhost:9000
MINIO_USE_SSL=false
MINIO_BUCKETNAME=mypanelexpress
MINIO_ACCESSKEY=minioadmin
MINIO_SECRETKEY=minioadmin

# --- Mail (formulaire de contact) ---
# En local, Mailpit écoute en SMTP clair sur 1025, sans authentification.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SSL=false
SMTP_LOGIN=
SMTP_KEY=
DO_NO_REPLY_MAIL=ne-pas-repondre@mypanelexpress.com
CONTACT_RECIPIENT_MAIL=contact@mypanelexpress.com

# --- pgAdmin (optionnel) ---
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=root
